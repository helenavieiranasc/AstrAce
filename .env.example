# Copie para .env e ajuste.
SECRET_KEY=troque-por-um-texto-aleatorio

# Sem DATABASE_URL, o app usa SQLite em instance/cienciadelas.db (bom para testar sozinha).
# Para MySQL:
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/cienciadelas?charset=utf8mb4

# 1 = quando ninguém entrou, age como a primeira usuária do banco. Use 0 com o login do Google configurado.
LOGIN_DEV=1

# Login com Google: crie um "ID do cliente OAuth" (Aplicativo da Web) no Google Cloud Console.
# URI de redirecionamento autorizado: http://127.0.0.1:5000/entrar/google/retorno (e o de produção).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional, atrás de proxy: o endereço de retorno completo.
# GOOGLE_REDIRECT_URI=https://seu-dominio/entrar/google/retorno

# Endereço público do site, usado nos QR codes de check-in (o celular precisa conseguir abrir).
# Vazio: usa o endereço por onde o painel foi aberto.
# URL_PUBLICA=https://seu-dominio
